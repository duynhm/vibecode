# Odoo Configuration
# Replace with your Odoo instance URL
NEXT_PUBLIC_ODOO_URL=https://your-odoo-instance.com

# Odoo Database Name
NEXT_PUBLIC_ODOO_DB=your_database_name

# Odoo API Credentials
# IMPORTANT: These should be kept secret and not exposed to the client
ODOO_USERNAME=your_odoo_username
ODOO_PASSWORD=your_odoo_password

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace the placeholder values with your actual Odoo credentials
# 3. Never commit .env.local to version control
# 4. NEXT_PUBLIC_ prefix makes variables available in the browser
# 5. Variables without NEXT_PUBLIC_ are only available server-side

# Example values:
# NEXT_PUBLIC_ODOO_URL=https://mycompany.odoo.com
# NEXT_PUBLIC_ODOO_DB=mycompany_production
# ODOO_USERNAME=api_user@mycompany.com
# ODOO_PASSWORD=your_secure_password_here
